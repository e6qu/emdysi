out_of_pocket_a2 := aj_-_i-att_le &
  [ ORTH < "out", "-", "of", "-", "pocket" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_out-of-pocket_a_1_rel",
             PHON.ONSET voc ] ].

out_of_process_a1 := aj_-_i-att_le &
  [ ORTH < "out-of", "-", "process" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_out-of-process_a_1_rel",
             PHON.ONSET voc ] ].

out_of_process_a2 := aj_-_i-att_le &
  [ ORTH < "out", "-", "of", "-", "process" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_out-of-process_a_1_rel",
             PHON.ONSET voc ] ].

out_of_tree_a1 := aj_-_i-att_le &
  [ ORTH < "out-of", "-", "tree" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_out-of-tree_a_1_rel",
             PHON.ONSET voc ] ].

out_of_tree_a2 := aj_-_i-att_le &
  [ ORTH < "out", "-", "of", "-", "tree" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_out-of-tree_a_1_rel",
