out_of_scope_a2 := aj_-_i-att_le &
  [ ORTH < "out", "-", "of", "-", "scope" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_out-of-scope_a_1_rel",
             PHON.ONSET voc ] ].

out_of_pocket_a1 := aj_-_i-att_le &
  [ ORTH < "out-of", "-", "pocket" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_out-of-pocket_a_1_rel",
