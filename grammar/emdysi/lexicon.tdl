;;; Adjectives used as plural nouns for people with the article "the":
;;; |the brave|, |home of the free|, |the meek|. The ERG lists 94 such
;;; nouns (type n_-_c-pl-def_le, e.g. |the poor|, |the rich|, |the old|);
;;; these are common ones it lacks, in the same form. |prime| is the
;;; garden-path sense (|The prime number few|: the best people are few).

:begin :instance :status lex-entry.

accused_n_pldef := n_-_c-pl-def_le &
  [ ORTH < "accused" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_accused_n_1_rel",
             PHON.ONSET voc ] ].

bereaved_n_pldef := n_-_c-pl-def_le &
  [ ORTH < "bereaved" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_bereaved_n_1_rel",
             PHON.ONSET con ] ].

