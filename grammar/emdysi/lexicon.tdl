;;; Adjectives the ERG lacks for nouns above: a native entry replaces the
;;; generic entries of an unknown word, so these would otherwise lose
;;; their adjective use (|an inexplicable result|), in the types of their
;;; positive counterparts (|probable|). Words with "un-" from an ERG
;;; adjective (|unusual|, |unexpected|) need none: the ERG derives them.

:begin :instance :status lex-entry.

unknowable_a1 := aj_-_i_le &
  [ ORTH < "unknowable" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_unknowable_a_1_rel",
             PHON.ONSET voc ] ].

inexplicable_a1 := aj_-_i_le &
  [ ORTH < "inexplicable" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_inexplicable_a_1_rel",
