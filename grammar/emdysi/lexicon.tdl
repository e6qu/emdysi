  [ ORTH < "improbable" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_improbable_a_1_rel",
             PHON.ONSET voc ] ].

:end :instance.

;;; Collective nouns with plural agreement: |The team are ready.| The
;;; ERG has this for "class", "committee" and "government" only, as
;;; British (type n_-_c-pl-nomcase_le, DIALECT br, e.g. committee_n2_br);
;;; these are other common ones in the same form, with the predicate of
;;; the ERG's own entry. "majority", "minority" and "staff" take a plural
;;; verb in American English too, so they have no dialect. Unlike the
;;; ERG's, these need an explicit determiner (SPR..--MIN explicit_q_rel):
;;; as plurals they would otherwise make a bare noun phrase of the singular
;;; form (|*I like team.|, |*Devito's department| read as |Devito is
;;; departments|).

