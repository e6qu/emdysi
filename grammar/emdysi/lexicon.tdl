             PHON.ONSET voc ] ].

at_risk_a1 := aj_-_i-att_le &
  [ ORTH < "at", "-", "risk" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_at-risk_a_1_rel",
             PHON.ONSET voc ] ].

on_chain_a1 := aj_-_i_le &
  [ ORTH < "on", "-", "chain" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_on-chain_a_1_rel",
             PHON.ONSET voc ] ].

compile_time_a1 := aj_-_i-att_le &
  [ ORTH < "compile", "-", "time" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_compile-time_a_1_rel",
             PHON.ONSET con ] ].

opt_in_a1 := aj_-_i-att_le &
  [ ORTH < "opt", "-", "in" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_opt-in_a_1_rel",
             PHON.ONSET voc ] ].

opt_out_a1 := aj_-_i-att_le &
  [ ORTH < "opt", "-", "out" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_opt-out_a_1_rel",
             PHON.ONSET voc ] ].

