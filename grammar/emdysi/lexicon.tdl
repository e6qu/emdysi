;;; Mass uses of nouns the ERG lists only as count nouns: |too much
;;; ceremony|, |without ceremony|. A count noun without a determiner is
;;; a grammar error the checker reports, so these are added one by one,
;;; never by a general rule.

:begin :instance :status lex-entry.

ceremony_n_mass := n_-_m_le &
  [ ORTH < "ceremony" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_ceremony_n_1_rel",
             PHON.ONSET con ] ].

:end :instance.

;;; Hyphenated compound adjectives the ERG lacks, in the form of its
;;; |in-house| and |on-site| entries (the tokenizer splits off the
;;; hyphens): |in-person voting|, |in-memory storage|, |at-risk
;;; children|, |compile-time checks|, |an opt-in feature|.

:begin :instance :status lex-entry.

in_person_a1 := aj_-_i_le &
  [ ORTH < "in", "-", "person" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_in-person_a_1_rel",
             PHON.ONSET voc ] ].

on_call_a1 := aj_-_i_le &
