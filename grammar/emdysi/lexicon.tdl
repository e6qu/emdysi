;;; "from" and "to" with adjectives: |The leaves range from yellowish to
;;; bluish.|, |It went from bad to worse.| The ERG's "from ... to"
;;; (from_to_nontemp, type p_np-pp_i-frm-to_le) takes noun phrases only.
;;; from_to_adj is its copy for a predicative adjective phrase, and its
;;; "to" phrase is to_prtcl_adj: a semantically empty "to" with an
;;; adjective phrase, in the type of the ERG's "of" in |the opposite of
;;; happy| (p_prd_ptcl-j_le), keyed _to_p_adj_rel so that nothing that
;;; selects an ordinary "to" phrase (|belong to|) takes it.

:begin :type.

_to_p_adj_rel := selected_prep_rel.

;; The ERG's ditrans_prep_synsem, p_ditrans_lexent and
;; p_ditrans_from_to_lexent, for an adjective phrase as first complement:
;; without its individual index (ARG2 overt_non_expl-ind) and nominal
;; MINORS (MIN nonpro_rel, ALTMIN quant_rel).
ditrans_prep_adj_synsem := prep_p_mod_synsem & norm_prep_synsem & basic_two_arg &
  [ LOCAL [ CAT [ HEAD prep & [ PRD + ],
                  VAL [ SPR < [ LOCAL [ CAT [ HEAD.MINORS
                                                 [ MIN much_deg_rel,
                                                   ALTMIN abstr_meas_nom_rel ],
                                            VAL [ SPR *olist*,
                                                  SPEC < synsem >,
                                                  COMPS < > ] ],
                                      CONT.HOOK [ LTOP #ltop,
                                                  XARG #arg0 ] ] ] >,
                      COMPS < [ --MIN #cmin,
                                NONLOC.QUE.LIST *paramlist*,
                                --SIND #objind ],
                              [ --MIN #ocmin,
                                LOCAL [ CAT.HEAD.TAM [ ASPECT no_aspect ],
					CONT.HOOK.LTOP #ltop ] ] > ] ],
	    CONT.RELS.LIST < prep_relation & #keyrel &
                             [ ARG2 #objind,
                               LBL #ltop,
                               ARG0 #arg0 ], ... > ],
    LKEYS [ KEYREL #keyrel,
	    --COMPKEY #cmin,
            --OCOMPKEY #ocmin ] ].

p_ditrans_from_to_adj_lexent := noncqrs-m &
  [ SYNSEM ditrans_prep_adj_synsem &
	 [ LOCAL [ CAT.VAL.COMPS < synsem & [ LOCAL [ CONJ cnil ],
                                            OPT - ],
                                 synsem & [ LOCAL [ CAT [ MC na,
							  VAL.COMPS < > ],
						    CONT.HOOK [ LTOP #ltop,
								INDEX non_expl,
								XARG #xarg ] ],
                                            NONLOC.QUE.LIST *paramlist*,
                                            OPT -,
                                            PUNCT.LPUNCT no_punct ] >,
                   CONT.HOOK [ LTOP #ltop,
			       XARG #xarg ] ],
           LKEYS [ KEYREL.LBL #ltop,
                   --COMPKEY #cmin,
                   --+COMPKEY #cmin,
                   --OCOMPKEY #ocmin,
                   --+OCOMPKEY #ocmin ] ] ].

;; The "to" phrase is semantically empty (to_prtcl_adj), so this "from"
;; also contributes the relation of "to", as the ERG's "to" does with a
;; noun phrase: |range from yellow to blue| means the same either way.
p_ap-pp_i-frm-to_le := p_ditrans_from_to_adj_lexent &
  [ SYNSEM [ LOCAL [ CAT.VAL.COMPS < [ OPT -,
				       LOCAL [ CAT [ HEAD adj & [ PRD + ],
						     VAL.COMPS < > ],
					       CONT.HOOK.LTOP #ltop ] ],
				     [ LOCAL.CONT.HOOK.INDEX #toind ] >,
                     CONT [ HOOK.LTOP #ltop,
			    RELS <! relation & [ ARG1 #arg1 ],
				    [ PRED _to_p_rel,
				      LBL #ltop,
				      ARG0 event,
				      ARG1 #arg1,
				      ARG2 #toind ] !>,
                            HCONS <! !>,
			    ICONS <! !> ] ] ] ].

:end :type.

:begin :instance :status lex-entry.

from_to_adj := p_ap-pp_i-frm-to_le &
 [ ORTH < "from" >,
   SYNSEM [ LKEYS [ --OCOMPKEY _to_p_adj_rel,
                    KEYREL.PRED _from_p_time_rel ],
            PHON.ONSET con ] ].

to_prtcl_adj := p_prd_ptcl-j_le &
 [ ORTH < "to" >,
   SYNSEM [ LKEYS.KEYREL.PRED _to_p_adj_rel,
            PHON.ONSET con ] ].

:end :instance.

;;; Older units of time, in the form of the ERG's |fortnight|
;;; (n_-_c-nday_le): |about a twelvemonth ago|, |a sennight later|.

:begin :instance :status lex-entry.

twelvemonth_n1 := n_-_c-nday_le &
 [ ORTH < "twelvemonth" >,
   SYNSEM [ LKEYS.KEYREL.PRED "_twelvemonth_n_1_rel",
            PHON.ONSET con ] ].

sennight_n1 := n_-_c-nday_le &
 [ ORTH < "sennight" >,
   SYNSEM [ LKEYS.KEYREL.PRED "_sennight_n_1_rel",
            PHON.ONSET con ] ].

:end :instance.

;;; Unknown plural names with a determiner: |The Bennets were able to eat.|,
;;; |the elder Miss Bennets|. The ERG makes an unknown name tagged NNPS
;;; singular (genericname_pl, type n_-_pn-unk_le: "the tagger is not
;;; always right with the NNPS tag"), so a family or a team takes no plural
;;; verb. This generic entry is plural, in the ERG's type for plural names
;;; with a determiner (n_-_pn-pl-def_le, |The Giants play today.|), so a
;;; bare singular name (|*Kubernetes are|) still does not agree. The
;;; ERG's lexical filter generic_name+ne_name_lfr would remove it beside the
;;; generic singular name of the same word (its comment means to keep
;;; plurals, but the singular is not yet inflected for number), so the
;;; parser exempts it from lexical filtering (ParserConfig::unfiltered).

:begin :type.

n_-_pn-pl-def-unk_le := n_-_pn-pl-def_le & basic_unknown_word &
  [ SYNSEM [ LKEYS.KEYREL.CARG #carg,
	     PHON.ONSET unk_onset ],
    TOKENS.+LIST < [ +CARG #carg ] > ].

:end :type.

:begin :instance :status generic-lex-entry.

genericname_pl_def := n_-_pn-pl-def-unk_le &
  [ ORTH < "_generic_nnps_" >,
    TOKENS.+LIST < [ +TNT.+TAGS.FIRST "NNPS" ] > ].

:end :instance.

;;; Transitive "meditate", to plan (|she meditated revenge|, |Miss Darcy's
;;; meditated elopement|): the ERG has it intransitive and with "on" only.

:begin :instance :status lex-entry.

meditate_v2 := v_np_le &
 [ ORTH < "meditate" >,
   SYNSEM [ LKEYS.KEYREL.PRED "_meditate_v_2_rel",
            PHON.ONSET con ] ].

:end :instance.

;;; "oftener" with a "than" complement (|it drew him oftener from home than
;;; anything else could do|), in the form of the ERG's |sooner|
;;; (sooner_comp_adv, av_pp_i-cmp_le). The ERG's oftener_adv takes none.

:begin :instance :status lex-entry.

oftener_comp_adv := av_pp_i-cmp_le &
 [ ORTH < "oftener" >,
   SYNSEM [ LKEYS.KEYREL.PRED "_often_a_1_rel",
            PHON.ONSET voc ] ].

:end :instance.

;;; Transitive "provision", to set up (|Autoscalers provision the Nodes|,
;;; |after swap is provisioned|): the ERG has it only with "with" (|provision
;;; the ship with food|). In the form of its |supply|, which has both
;;; (supply_v1, v_np_le, beside supply_with_v1).

:begin :instance :status lex-entry.

provision_v1 := v_np_le &
 [ ORTH < "provision" >,
   SYNSEM [ LKEYS.KEYREL.PRED "_provision_v_1_rel",
            PHON.ONSET con ] ].

:end :instance.

;;; Nouns the ERG lacks or has only as mass nouns: |compile time| (|at
;;; compile time|, 39 times in the development corpora), in the form of
;;; its |runtime| (n_-_mc_le); |a redirect|, |HTTP redirects|; |transport|
;;; as a count noun, a fit of emotion (|the first transports of rage|), which
;;; the ERG has only as a mass noun (transport_n1, n_-_m_le); nouns it has
;;; only as verbs: |a recap of the many skills| (in the form of its
;;; |summary|, n_pp_c-of_le), |the decease of the incumbent| (of its |death|,
;;; n_-_mc_le), |the entail of Longbourn estate|, an entailment of property.

:begin :instance :status lex-entry.

compile_time_n1 := n_-_mc_le &
 [ ORTH < "compile", "time" >,
   SYNSEM [ LKEYS.KEYREL.PRED "_compile+time_n_1_rel",
            PHON.ONSET con ] ].

redirect_n1 := n_-_c_le &
 [ ORTH < "redirect" >,
   SYNSEM [ LKEYS.KEYREL.PRED "_redirect_n_1_rel",
            PHON.ONSET con ] ].

recap_n1 := n_pp_c-of_le &
 [ ORTH < "recap" >,
   SYNSEM [ LKEYS.KEYREL.PRED "_recap_n_of_rel",
            PHON.ONSET con ] ].

decease_n1 := n_-_mc_le &
 [ ORTH < "decease" >,
   SYNSEM [ LKEYS.KEYREL.PRED "_decease_n_1_rel",
            PHON.ONSET con ] ].

entail_n1 := n_-_c_le &
 [ ORTH < "entail" >,
   SYNSEM [ LKEYS.KEYREL.PRED "_entail_n_1_rel",
            PHON.ONSET voc ] ].

transport_n2 := n_-_c_le &
 [ ORTH < "transport" >,
   SYNSEM [ LKEYS.KEYREL.PRED "_transport_n_2_rel",
            PHON.ONSET con ] ].

:end :instance.

;;; |altogether| before a verb (|The evening altogether passed off
;;; pleasantly|, |he altogether failed|): the ERG's altogether_adv1
;;; (av_-_i-vp-po_le) follows its verb only. This copy precedes it, in the
;;; ERG's type for |later| in |he later left| (later_adv2, av_-_i-vp-pr_le).

:begin :instance :status lex-entry.

altogether_adv2 := av_-_i-vp-pr_le &
 [ ORTH < "altogether" >,
   SYNSEM [ LKEYS.KEYREL.PRED "_altogether_a_1_rel",
            PHON.ONSET voc ] ].

:end :instance.
