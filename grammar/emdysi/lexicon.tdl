;;; |onboard|, which the ERG lacks: a preposition like |aboard| (|330 crew
;;; are onboard the ship|), an adjective (|onboard storage|) and a verb
;;; (|onboard new users|), all three since a native entry replaces the
;;; generic ones.

:begin :instance :status lex-entry.

onboard_p := p_np_i_le &
  [ ORTH < "onboard" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_onboard_p_rel",
             PHON.ONSET voc ] ].

onboard_pp := pp_-_i_le &
  [ ORTH < "onboard" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_onboard_p_rel",
             PHON.ONSET voc ] ].

onboard_a1 := aj_-_i_le &
  [ ORTH < "onboard" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_onboard_a_1_rel",
             PHON.ONSET voc ] ].

onboard_v1 := v_np*_le &
  [ ORTH < "onboard" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_onboard_v_1_rel",
             PHON.ONSET voc ] ].

:end :instance.

;;; Hyphenated |out-of-X| compound adjectives the ERG lacks, before a noun
;;; (|out-of-memory kills|, |out-of-band data|), in the form of its
;;; |out-of-court| entries (its tokenizer splits them as "out-of" or "out",
;;; "of", with the hyphens).

:begin :instance :status lex-entry.

out_of_memory_a1 := aj_-_i-att_le &
  [ ORTH < "out-of", "-", "memory" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_out-of-memory_a_1_rel",
             PHON.ONSET voc ] ].

out_of_memory_a2 := aj_-_i-att_le &
  [ ORTH < "out", "-", "of", "-", "memory" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_out-of-memory_a_1_rel",
             PHON.ONSET voc ] ].

out_of_band_a1 := aj_-_i-att_le &
  [ ORTH < "out-of", "-", "band" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_out-of-band_a_1_rel",
             PHON.ONSET voc ] ].

out_of_band_a2 := aj_-_i-att_le &
  [ ORTH < "out", "-", "of", "-", "band" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_out-of-band_a_1_rel",
             PHON.ONSET voc ] ].

out_of_order_a1 := aj_-_i-att_le &
  [ ORTH < "out-of", "-", "order" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_out-of-order_a_1_rel",
