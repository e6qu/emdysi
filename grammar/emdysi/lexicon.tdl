in_memory_a1 := aj_-_i_le &
  [ ORTH < "in", "-", "memory" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_in-memory_a_1_rel",
             PHON.ONSET voc ] ].

in_place_a1 := aj_-_i-att_le &
  [ ORTH < "in", "-", "place" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_in-place_a_1_rel",
             PHON.ONSET voc ] ].

at_risk_a1 := aj_-_i-att_le &
  [ ORTH < "at", "-", "risk" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_at-risk_a_1_rel",
             PHON.ONSET voc ] ].

on_chain_a1 := aj_-_i_le &
  [ ORTH < "on", "-", "chain" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_on-chain_a_1_rel",
             PHON.ONSET voc ] ].

compile_time_a1 := aj_-_i-att_le &
  [ ORTH < "compile", "-", "time" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_compile-time_a_1_rel",
             PHON.ONSET con ] ].

opt_in_a1 := aj_-_i-att_le &
  [ ORTH < "opt", "-", "in" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_opt-in_a_1_rel",
             PHON.ONSET voc ] ].

opt_out_a1 := aj_-_i-att_le &
  [ ORTH < "opt", "-", "out" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_opt-out_a_1_rel",
             PHON.ONSET voc ] ].

ill_behaved_a1 := aj_-_i_le &
  [ ORTH < "ill", "-", "behaved" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_ill-behaved_a_1_rel",
             PHON.ONSET voc ] ].

;; |opt-in| and |opt-out| as nouns, mass or count (|via opt-out|, |an opt-in|), in the
;; form of the ERG's |roll-out| (roll_out_n2, n_-_mc_le).

opt_in_n1 := n_-_mc_le &
  [ ORTH < "opt", "-", "in" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_opt-in_n_1_rel",
             PHON.ONSET voc ] ].

opt_out_n1 := n_-_mc_le &
  [ ORTH < "opt", "-", "out" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_opt-out_n_1_rel",
             PHON.ONSET voc ] ].

:end :instance.

;;; Technical vocabulary the ERG lacks: |a borrow| (Rust), |swap| (memory
;;; swapped to disk, mass), |metrics| as a noun that modifies nouns (|a
;;; metrics pipeline|, like the ERG's |statistics|), intransitive
;;; |evaluate| (|the expression evaluates to 5|), and |out-of-the-box|.

:begin :instance :status lex-entry.

borrow_n1 := n_-_c_le &
  [ ORTH < "borrow" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_borrow_n_1_rel",
             PHON.ONSET con ] ].

swap_n_mass := n_-_m_le &
  [ ORTH < "swap" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_swap_n_2_rel",
             PHON.ONSET con ] ].

metrics_n1 := n_-_m_le &
  [ ORTH < "metrics" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_metrics_n_1_rel",
             PHON.ONSET con ] ].

evaluate_v_intr := v_-_le &
  [ ORTH < "evaluate" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_evaluate_v_1_rel",
             PHON.ONSET voc ] ].

out_of_the_box_a1 := aj_-_i_le &
  [ ORTH < "out-of", "-", "the", "-", "box" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_out-of-the-box_a_1_rel",
