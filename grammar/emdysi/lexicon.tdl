;;; Technical vocabulary the ERG lacks: |a borrow| (Rust), |swap| (memory
;;; swapped to disk, mass), |metrics| as a noun that modifies nouns (|a
;;; metrics pipeline|, like the ERG's |statistics|), intransitive
;;; |evaluate| (|the expression evaluates to 5|), and |out-of-the-box|.

:begin :instance :status lex-entry.

borrow_n1 := n_-_c_le &
  [ ORTH < "borrow" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_borrow_n_1_rel",
             PHON.ONSET con ] ].

swap_n_mass := n_-_m_le &
  [ ORTH < "swap" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_swap_n_2_rel",
             PHON.ONSET con ] ].

metrics_n1 := n_-_m_le &
  [ ORTH < "metrics" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_metrics_n_1_rel",
             PHON.ONSET con ] ].

evaluate_v_intr := v_-_le &
  [ ORTH < "evaluate" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_evaluate_v_1_rel",
             PHON.ONSET voc ] ].

out_of_the_box_a1 := aj_-_i_le &
  [ ORTH < "out-of", "-", "the", "-", "box" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_out-of-the-box_a_1_rel",
             PHON.ONSET voc ] ].

out_of_the_box_a2 := aj_-_i_le &
  [ ORTH < "out", "-", "of", "-", "the", "-", "box" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_out-of-the-box_a_1_rel",
             PHON.ONSET voc ] ].

out_of_the_box_pp1 := pp_-_i_le &
  [ ORTH < "out-of", "-", "the", "-", "box" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_out-of-the-box_a_1_rel",
             PHON.ONSET voc ] ].

out_of_the_box_pp2 := pp_-_i_le &
  [ ORTH < "out", "-", "of", "-", "the", "-", "box" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_out-of-the-box_a_1_rel",
             PHON.ONSET voc ] ].

:end :instance.

;;; Adjectives the ERG lacks for nouns above: a native entry replaces the
;;; generic entries of an unknown word, so these would otherwise lose
;;; their adjective use (|an inexplicable result|), in the types of their
;;; positive counterparts (|probable|). Words with "un-" from an ERG
;;; adjective (|unusual|, |unexpected|) need none: the ERG derives them.

:begin :instance :status lex-entry.

unknowable_a1 := aj_-_i_le &
  [ ORTH < "unknowable" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_unknowable_a_1_rel",
             PHON.ONSET voc ] ].

inexplicable_a1 := aj_-_i_le &
  [ ORTH < "inexplicable" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_inexplicable_a_1_rel",
             PHON.ONSET voc ] ].

improbable_a1 := aj_-_i_le &
  [ ORTH < "improbable" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_improbable_a_1_rel",
             PHON.ONSET voc ] ].

improbable_a2 := aj_cp_i-it_le &
  [ ORTH < "improbable" >,
    SYNSEM [ LKEYS.KEYREL.PRED "_improbable_a_1_rel",
             PHON.ONSET voc ] ].

:end :instance.
